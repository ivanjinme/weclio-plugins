{
  "name": "@weclio/pi-submarine",
  "version": "0.2.0",
  "description": "Weclio-maintained Pi extension for focused foreground child-session delegation.",
  "author": "Daniel Nouri",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivanjinme/weclio-plugins.git",
    "directory": "extensions/pi-submarine"
  },
  "homepage": "https://github.com/ivanjinme/weclio-plugins/tree/main/extensions/pi-submarine",
  "bugs": {
    "url": "https://github.com/ivanjinme/weclio-plugins/issues"
  },
  "type": "module",
